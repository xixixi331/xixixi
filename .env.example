# 复制为 .env 后填入自己的 key：cp .env.example .env

# ---- 大模型（任何 OpenAI 兼容接口都行：智谱 / DeepSeek / Moonshot / 本地 Ollama）----
LLM_API_KEY=""
LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
LLM_MODEL="glm-4.5-air"

# 可选：enabled / disabled / 留空
# 智谱 4.5 之后的模型默认带思考过程，RAG 场景关掉更快更简洁。
# 注意 glm-5.3-flash 这类「始终思考」的模型不接受 disabled，会报 400。
LLM_THINKING="disabled"

# ---- 向量模型 ----
# local : 本地跑 BAAI/bge-small-zh-v1.5（512 维，约 95MB，CPU 可跑）
# openai: 走 OpenAI 兼容的 embeddings 接口（需该服务支持）
EMBED_PROVIDER="local"
EMBED_MODEL="BAAI/bge-small-zh-v1.5"

# ---- 可选：国内网络下走 HF 镜像 ----
# HF_ENDPOINT="https://hf-mirror.com"
